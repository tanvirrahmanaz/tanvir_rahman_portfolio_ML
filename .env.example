# ── Database (Supabase → Project Settings → Database → Connection string → URI) ──
# "Transaction" pooler URL use korben Vercel er jonno (port 6543), ?pgbouncer=true soho
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ── Auth ──
# `openssl rand -base64 32` diye generate korun
NEXTAUTH_SECRET="change-me-to-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── First admin user (seed script ei email/password diye admin banabe) ──
ADMIN_EMAIL="tanvirrahmanaz@gmail.com"
ADMIN_PASSWORD="changeme123"

# ── imgbb (https://api.imgbb.com/ theke free API key) ──
IMGBB_API_KEY=""
